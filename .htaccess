Options -Indexes
<FilesMatch "(\.(sqlite|md|yml)|^TEMP-LOGIN\.txt)$">
  Require all denied
</FilesMatch>
# Block git metadata, tests and example config when the repo is cloned straight into the web root.
RedirectMatch 404 /(\.git|tests)(/|$)
RedirectMatch 404 /config\.local\.example\.php$

# Browser caching for static assets (Apache / LiteSpeed). File names carry ?v= on CSS/JS, so long caching is safe.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript image/svg+xml
</IfModule>

# Landing page must not appear in Google search (ads traffic only).
<IfModule mod_headers.c>
  Header set X-Robots-Tag "noindex, nofollow"
</IfModule>
